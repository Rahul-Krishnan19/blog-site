# GitHub fine-grained PAT, scoped to the repo below, with
# Discussions: Read-only (Metadata: Read-only is auto-included).
GITHUB_TOKEN=

# The repo whose Discussions back this blog.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Discussion category to treat as published. Anything in another
# category (e.g. "Drafts") never appears on the site.
GITHUB_POSTS_CATEGORY_NAME=Posts

# Optional: only needed if you wire up the GitHub webhook -> /api/revalidate
# for instant updates instead of waiting for the 5 minute ISR window.
GITHUB_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
